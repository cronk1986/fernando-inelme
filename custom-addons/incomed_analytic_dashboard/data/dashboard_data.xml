<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Dashboard: Analítica (dentro del grupo Finance estándar) -->
    <record id="spreadsheet_dashboard_analytic" model="spreadsheet.dashboard">
        <field name="name">Analítica</field>
        <field name="spreadsheet_binary_data" type="base64"
               file="incomed_analytic_dashboard/data/files/analytic_dashboard.json"/>
        <field name="main_data_model_ids"
               eval="[(4, ref('incomed_analytic_dashboard.model_analytic_dashboard_report'))]"/>
        <field name="dashboard_group_id"
               ref="spreadsheet_dashboard.spreadsheet_dashboard_group_finance"/>
        <field name="group_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="sequence">20</field>
        <field name="is_published">True</field>
    </record>

</odoo>
