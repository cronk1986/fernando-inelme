<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View (estructura idéntica a la captura) -->
    <record id="view_analytic_dashboard_report_list" model="ir.ui.view">
        <field name="name">analytic.dashboard.report.list</field>
        <field name="model">analytic.dashboard.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="parent_analytic_id"/>
                <field name="analytic_account_id"/>
                <field name="ref"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="date"/>
                <field name="debit" sum="Total Debe"/>
                <field name="credit" sum="Total Haber"/>
                <field name="balance" sum="Saldo"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_analytic_dashboard_report_pivot" model="ir.ui.view">
        <field name="name">analytic.dashboard.report.pivot</field>
        <field name="model">analytic.dashboard.report</field>
        <field name="arch" type="xml">
            <pivot string="Tablero Analítico">
                <field name="parent_analytic_id" type="row"/>
                <field name="analytic_account_id" type="row"/>
                <field name="debit" type="measure"/>
                <field name="credit" type="measure"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_analytic_dashboard_report_graph" model="ir.ui.view">
        <field name="name">analytic.dashboard.report.graph</field>
        <field name="model">analytic.dashboard.report</field>
        <field name="arch" type="xml">
            <graph string="Tablero Analítico" type="bar" stacked="1">
                <field name="parent_analytic_id"/>
                <field name="debit" type="measure"/>
                <field name="credit" type="measure"/>
                <field name="balance" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_analytic_dashboard_report_search" model="ir.ui.view">
        <field name="name">analytic.dashboard.report.search</field>
        <field name="model">analytic.dashboard.report</field>
        <field name="arch" type="xml">
            <search string="Tablero Analítico">
                <field name="analytic_account_id"/>
                <field name="parent_analytic_id"/>
                <field name="partner_id"/>
                <field name="ref"/>
                <separator/>
                <filter string="Fecha" name="filter_date" date="date"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string="Cuenta analítica madre" name="group_parent"
                            context="{'group_by': 'parent_analytic_id'}"/>
                    <filter string="Cuenta analítica" name="group_account"
                            context="{'group_by': 'analytic_account_id'}"/>
                    <filter string="Cliente" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Plan" name="group_plan"
                            context="{'group_by': 'plan_id'}"/>
                    <filter string="Fecha" name="group_date"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Vista lista agrupada por cuenta madre + cuenta analítica -->
    <record id="action_analytic_dashboard_report" model="ir.actions.act_window">
        <field name="name">Informe Analítico</field>
        <field name="res_model">analytic.dashboard.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_analytic_dashboard_report_search"/>
        <field name="context">{
            'search_default_group_parent': 1,
            'search_default_group_account': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay datos analíticos para mostrar
            </p>
        </field>
    </record>

</odoo>
